{
  "name": "@sherluok/com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "types": "node --import tsx ./scripts/generate-cloudflare-worker-types.ts",
    "build": "wrangler deploy --dry-run --outdir ./.wrangler/dist",
    "deploy": "wrangler deploy",
    "list-sessions": "wrangler kv key list --binding=session",
    "cloudflare:dev": "wrangler dev",
    "web:dev": "node --import tsx ./scripts/watch-web.ts"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@sherluok/webpack": "workspace:*",
    "@types/node": "^24.2.1",
    "remark-mdx-toc": "^0.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.28.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/recipes": "^0.5.6",
    "drizzle-orm": "^0.44.4",
    "esbuild": "^0.25.8",
    "mimetext": "^3.0.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.0",
    "rxjs": "^7.8.2",
    "zod": "^4.0.17"
  }
