{
  "name": "@sherluok/com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "types": "node --import tsx ./scripts/generate-cloudflare-worker-types.ts",
    "build": "wrangler deploy --dry-run --outdir ./.wrangler/dist",
    "deploy": "wrangler deploy",
    "list-sessions": "wrangler kv key list --binding=session",
    "cloudflare:dev": "wrangler dev",
    "web:dev": "node --import tsx ./scripts/watch-web.ts"
  },
  "devDependencies": {
    "@sherluok/webpack": "workspace:*",
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.19.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vanilla-extract/css": "^1.17.3",
    "@vanilla-extract/recipes": "^0.5.6",
    "drizzle-orm": "^0.44.2",
    "esbuild": "^0.25.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.56"
  }
}
