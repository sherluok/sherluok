{
  "name": "sherluok-com",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2025-06-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  // https://developers.cloudflare.com/workers/wrangler/configuration/#local-development-settings
  "dev": {
    "port": 8787
  },
  // https://developers.cloudflare.com/workers/configuration/routing/
  "routes": [
    {
      "pattern": "sherluok.com",
      "custom_domain": true
    }
  ],
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // https://developers.cloudflare.com/workers/wrangler/commands/#kv-namespace
  // https://developers.cloudflare.com/kv/get-started/
  "kv_namespaces": [
    {
      "id": "fa74d13747434bfba26046eda167a11d",
      "binding": "tokens"
    }
  ],
  // https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket
  // https://developers.cloudflare.com/r2/api/workers/workers-api-reference/
  "r2_buckets": [
    {
      "bucket_name": "sherluok-static",
      "binding": "static"
    },
    {
      "bucket_name": "sherluok-storage",
      "binding": "storage"
    }
  ],
  // https://developers.cloudflare.com/workers/wrangler/configuration/#email-bindings
  // https://developers.cloudflare.com/email-routing/email-workers/local-development/
  // https://developers.cloudflare.com/email-routing/setup/email-routing-addresses/
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
