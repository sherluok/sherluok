    "./react": "./src/exports/react.tsx",
    "./zod": "./src/exports/zod.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.116.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-reconciler": "^0.32.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.17",
    "esbuild": "^0.25.8",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "unist-util-visit": "^5.0.0"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/recipes": "^0.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-reconciler": "^0.32.0",
    "react-router": "^7.8.0",
    "rxjs": "^7.8.2",
    "zod": "^4.0.17"
  }
}
