{
  "name": "@sherluok/figma-icons-exporter",
  "version": "0.1.20250316",
  "scripts": {
    "test": "node --import tsx --test ./src/**/*.test.ts",
    "watch": "node --import tsx ./scripts/commands/watch.ts",
    "build": "node --import tsx ./scripts/commands/build.ts",
    "serve": "node --import tsx --watch ./src/server/main.ts"
  },
  "bin": {
    "serve": "./build/server/main.js"
  },
  "exports": {
    ".": "./src/exports/common.ts",
